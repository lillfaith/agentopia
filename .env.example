# ─────────────────────────────────────────────────────────────
#  Agentopia configuration. Copy to `.env` and fill in.
#  Secrets live ONLY on the server. They are never sent to the browser.
# ─────────────────────────────────────────────────────────────

# Claude API key (https://console.anthropic.com). Required for real agent work.
ANTHROPIC_API_KEY=

# Default model for newly created agents (each agent can override in its panel).
AGENTOPIA_DEFAULT_MODEL=claude-opus-5-5

# Server-side refusal fallback for models that support it: "default" or "off".
AGENTOPIA_REFUSAL_FALLBACK=default

# Network binding. Keep 127.0.0.1 for local use. If you bind to anything else
# (e.g. 0.0.0.0 on a cloud server) you MUST set AGENTOPIA_ADMIN_TOKEN.
HOST=127.0.0.1
PORT=8787

# Bearer token required by the HTTP API when set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENTOPIA_ADMIN_TOKEN=

# SQLite database file (created automatically).
AGENTOPIA_DB_PATH=./data/agentopia.sqlite

# Hard stop: no new model calls start once today's estimated spend (UTC) reaches this. 0 = no cap.
AGENTOPIA_DAILY_BUDGET_USD=5

# Per-task safety limits.
AGENTOPIA_MAX_TURNS_PER_TASK=8
AGENTOPIA_MAX_OUTPUT_TOKENS=16000
AGENTOPIA_MAX_DELEGATION_DEPTH=3

# Worker: how many tasks may run at once, and how often the queue is polled.
AGENTOPIA_WORKER_CONCURRENCY=2
AGENTOPIA_WORKER_POLL_MS=1500

# OFFLINE SIMULATION (for UI demos/tests without an API key). When "true" AND no
# ANTHROPIC_API_KEY is set, agents produce canned, clearly-labelled [SIMULATED]
# output at $0. Simulated work is flagged everywhere in the UI and database.
AGENTOPIA_SIMULATION=false
